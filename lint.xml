<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration du Lint partagée par la commande Gradle et l'analyse d'Android Studio, pour tous les modules. -->
<lint>
    <!--
        Les versions plus récentes proposées (AGP 9, Kotlin 2, Koin 4, Realm 3…) imposent une migration complète
        du projet, aujourd'hui en Kotlin 1.8 : les versions restent figées dans gradle.properties.
    -->
    <issue id="GradleDependency" severity="ignore" />
    <!-- Pareil pour le plugin Android (AGP 8.1.4) : passer à AGP 9 demanderait de passer à Kotlin 2. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!--
        Fausse alerte : le plugin kotlinx.serialization crée du code caché pour chaque @Serializable,
        et l'inspection d'Android Studio le prend pour notre code. On l'ignore seulement pour les DTO.
    -->
    <issue id="UnsafeOptInUsageError">
        <ignore path="**/remote/responses/**" />
    </issue>
</lint>
