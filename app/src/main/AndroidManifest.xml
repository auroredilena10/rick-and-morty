<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission normale : Ktor interroge l'API Rick et Morty, aucune demande à l'utilisateur. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permission normale : VibrationManagerImpl fait vibrer l'appareil au clic sur la carte d'un lieu. Sans cette ligne, Android bloque l'appel. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        CleanRmApiApplication démarre Koin avant toute activité, pour que les ViewModels trouvent leurs dépendances.
        Les fichiers de règles de sauvegarde sont encore les modèles vides d'Android Studio : tout est sauvegardé par défaut.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Projet2"
        android:name="org.mathieu.cleanrmapi.CleanRmApiApplication"
        tools:targetApi="31">
        <!--
            Single Activity : tous les écrans sont des destinations du NavHost de cette activité.
            exported="true" car c'est le point d'entrée du lanceur (MAIN / LAUNCHER).
        -->
        <activity
            android:name="org.mathieu.cleanrmapi.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Projet2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>